<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.TilePane?>

<ScrollPane fx:id="galleryScrollPane"
            fitToHeight="true"
            pannable="true"
            prefHeight="130.0"
            maxHeight="130.0"
            style="-fx-background: transparent; -fx-background-color: rgba(0, 0, 0, 0.6);"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.dsf.imagemirador.Controller.GalleryController">
    <content>
        <TilePane fx:id="tilePane"
                  hgap="10.0"
                  vgap="10.0"
                  style="-fx-background-color: transparent;"
                  tileAlignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </TilePane>
    </content>
</ScrollPane>